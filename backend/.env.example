# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=3001
API_RELOAD=true

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Whisper Configuration
# Model options: tiny, base, small, medium, large, large-v2, large-v3
# large-v3 provides best accuracy but requires more RAM and disk space
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_DOWNLOAD_ROOT=./models

# File Upload Configuration
MAX_FILE_SIZE_MB=100
ALLOWED_AUDIO_TYPES=m4a,mp3,wav,webm,ogg

# Rate Limiting
# Maximum number of requests per minute per IP
RATE_LIMIT_PER_MINUTE=10

# Logging
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Options: json, console
LOG_FORMAT=json

# Security
TEMP_DIR=./temp
CLEANUP_TEMP_FILES=true
